{
  "name": "opencode-codex-usage-plugin",
  "version": "0.0.3",
  "description": "OpenCode TUI plugin that shows Codex usage and reset times.",
  "keywords": [
    "codex",
    "opencode",
    "opencode-plugin",
    "tui",
    "usage"
  ],
  "homepage": "https://github.com/zaniluca/opencode-codex-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/zaniluca/opencode-codex-usage-plugin/issues"
  },
  "license": "MIT",
  "author": "Luca Zani <zani.luca@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaniluca/opencode-codex-usage-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "effect-language-service patch",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2",
    "effect": "4.1.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.0",
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.9.7",
    "@opentui/solid": "0.9.7",
    "@types/node": "^24.10.1",
    "@types/ws": "8.18.2",
    "oxfmt": "^0.56.0",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": "^1.9.12"
  },
  "engines": {
    "opencode": ">=2.3.0"
  },
  "packageManager": "pnpm@10.33.0"
}
